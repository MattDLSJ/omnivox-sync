# Copy to .env and fill in. .env is gitignored and must never be committed.

# REQUIRED for anything scheduled. Not required to run it by hand.
#
# `make login` opens a real browser, you sign in, and the profile it stores
# keeps Omnivox's TRUSTED-DEVICE cookie, which is what stops the six-digit
# codes. It does not keep the SESSION cookie: that one dies when the browser
# closes, and every scheduled run opens a fresh browser.
#
# Measured over 93 scheduled runs: 114 form logins, zero session reuses. So a
# scheduled run signs in with a password every single time, and a copy with
# none here simply stops working the moment nobody is watching.
#
# `make login` offers to save these for you at the end, from what you typed
# into the browser, so normally you never touch this by hand. `make
# setup-omnivox` does it later if you said no.
OMNIVOX_USER=
OMNIVOX_PASS=
# Optional, only if digest.ranking = "gemini" (Milestone 3)
GEMINI_API_KEY=

# Secret iCal address of the School calendar, used to mirror it into each
# course's _horaire.md so NotebookLM can see the content and your notes.
# Google Calendar > Settings > (your School calendar) > Integrate calendar >
# "Secret address in iCal format". Anyone holding this URL can read the whole
# calendar, so it belongs here and never in config.yaml. Optional: without it
# the mirror simply does not run.
SCHOOL_ICS_URL=

# i+ Interactif (Chenelière) account, used by `make books` to pull the pages
# your teachers assign out of the digital textbooks. Optional: without it the
# textbook scraper simply does not run.
CHENELIERE_USER=
CHENELIERE_PASS=

# ntfy.sh topic for phone push notifications. Pick any random string nobody
# else would guess, then subscribe to the same name in the ntfy app. A topic
# is PUBLIC to whoever knows it: anyone with the name can read your
# notifications and send you fake ones, which is why it lives here and not in
# config.yaml. Optional: empty = Mac notifications only.
NTFY_TOPIC=
